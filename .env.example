# ─────────────────────────────────────────────────────────────
# 20FIT AD STUDIO — Environment Variables
# Copy to .env.local for local dev, or set these in Railway → Variables.
# The app boots and renders even with NONE of these set (demo mode);
# individual features activate as their keys are provided.
# ─────────────────────────────────────────────────────────────

# ---- Claude / Anthropic (required for AI copy generation) ----
ANTHROPIC_API_KEY=sk-ant-...
# Model used server-side by /api/generate. Override if your account
# uses a different model id. Defaults to claude-sonnet-4-5 in code.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Supabase (required for history, assets, banners) ----
# Client-safe values (exposed to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only (never exposed to the browser):
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- App ----
NEXT_PUBLIC_APP_URL=https://ads.20fit.id

# ---- Rate limiting (optional overrides) ----
# Max AI generations per user per hour (default 20).
AI_RATE_LIMIT_PER_HOUR=20

# ---- Ad platform integrations (optional — auto-sync in Reports) ----
# Encryption key for OAuth tokens stored in Supabase. REQUIRED for any
# integration. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Google Ads API — OAuth client from Google Cloud Console (Ads API enabled).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Developer token is OPTIONAL since Google's 2026-09-09 sunset (access now
# attaches to the OAuth client's Cloud project). Still sent if provided.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) account id, digits only — sent as login-customer-id when set,
# and used as the queried account id if account discovery is unavailable.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# API version override (defaults to v25 in code). Verify the current version:
# https://developers.google.com/google-ads/api/docs/concepts/versioning
GOOGLE_ADS_API_VERSION=v25
